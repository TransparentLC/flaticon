{
    "type": "module",
    "scripts": {
        "check": "biome check --write --unsafe",
        "dev": "tsx watch --env-file=.env src/index.ts | pino-pretty",
        "build": "esbuild --bundle --minify --charset=utf8 --platform=node --format=esm --packages=external --outfile=dist/index.js src/index.ts",
        "serve": "node --env-file=.env dist/index.js"
    },
    "dependencies": {
        "@hono/node-server": "^2.1.5",
        "hono": "^4.13.14",
        "hono-rate-limiter": "^0.5.4",
        "lru-cache": "^11.5.3",
        "pino": "^10.4.0",
        "undici": "^8.12.3"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.6.3",
        "@commitlint/cli": "^21.2.4",
        "@commitlint/config-conventional": "^21.2.4",
        "@types/node": "^26.6.5",
        "esbuild": "^0.28.2",
        "lefthook": "^2.2.2",
        "pino-pretty": "^13.2.0",
        "tsx": "^4.23.15"
    }
}
